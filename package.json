{
  "name": "caldesk",
  "version": "1.0.0",
  "description": "Windows 桌面待办与日历：内置 MCP 服务让 AI 客户端直接读写日程，配 Cloudflare Worker 可与手机同步",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Mortonnn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mortonnn/caldesk.git"
  },
  "homepage": "https://github.com/Mortonnn/caldesk#readme",
  "bugs": {
    "url": "https://github.com/Mortonnn/caldesk/issues"
  },
  "bin": {
    "cal": "bin/cal.mjs",
    "cal-mcp": "bin/cal-mcp.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "sync:android": "npm run build:mobile && cap sync android",
    "android:overrides": "node scripts/apply-android-overrides.mjs",
    "apk": "npm run sync:android && npm run android:overrides && cd android && gradlew assembleDebug",
    "start": "electron-vite preview",
    "cal": "node bin/cal.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node scripts/verify-all.mjs",
    "test:fast": "node scripts/verify-all.mjs --fast",
    "test:list": "node scripts/verify-all.mjs --list",
    "test:rrule": "node scripts/verify-rrule.mjs",
    "test:rrule-parity": "node scripts/verify-rrule-parity.mjs",
    "test:calendar": "node scripts/verify-calendar.mjs",
    "test:snapshots": "node scripts/verify-snapshots.mjs",
    "test:db": "node scripts/verify-db.mjs",
    "test:db-main": "node scripts/verify-db-main.mjs",
    "test:contract": "node scripts/contract.mjs",
    "test:auth": "node scripts/verify-auth.mjs",
    "test:mcp": "node scripts/verify-mcp.mjs",
    "test:cli": "node scripts/verify-cli.mjs",
    "test:sync": "node scripts/verify-sync-e2e.mjs",
    "test:interop": "node scripts/verify-interop.mjs",
    "test:ui": "node scripts/ui-desktop.mjs",
    "test:ui-faults": "node scripts/ui-faults.mjs",
    "test:mobile": "node scripts/mobile-verify.mjs",
    "test:mobile-device": "node scripts/mobile-device.mjs",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "date-fns": "4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "framer-motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
